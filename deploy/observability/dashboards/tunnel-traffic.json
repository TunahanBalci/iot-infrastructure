            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(ts) AS time, position,\n  sum(missed) / greatest(sum(missed + detections), 1) AS miss_rate\nFROM iot.sensor_health\nWHERE $__timeFilter(ts) AND tunnel_id IN (${tunnel:singlequote})\nGROUP BY time, position\nORDER BY time",
          "format": 0,
