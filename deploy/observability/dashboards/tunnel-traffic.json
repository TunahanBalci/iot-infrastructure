    {
      "type": "table",
      "title": "Devices by latest status (last 10 min)",
      "description": "Counts the 3 devices per tunnel by their latest self-reported status. The window is on device time, so a skewed sensor clock empties this.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT status, count() AS sensors\nFROM (\n  SELECT sensor_id, argMax(status, ts) AS status\n  FROM iot.sensor_health\n  WHERE ts > now() - INTERVAL 10 MINUTE AND tunnel_id IN (${tunnel:singlequote})\n  GROUP BY sensor_id\n)\nGROUP BY status\nORDER BY status",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.21.3",
          "refId": "A"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "No device reported in the last 10 min - the devices are down, or their clocks are skewed."
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 0,
        "y": 32
      }
    },
    {
