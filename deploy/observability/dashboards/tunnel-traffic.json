    {
      "type": "table",
      "title": "Vehicles per tunnel and type",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT tunnel_id,\n  sumIf(vehicles, classification = 'OTOMOBIL') AS otomobil,\n  sumIf(vehicles, classification IN ('HAFIF_TICARI', 'MINIBUS')) AS hafif,\n  sumIf(vehicles, classification IN ('KAMYON', 'CEKICI_YARI_ROMORK', 'OTOBUS')) AS agir,\n  sumIf(vehicles, classification IN ('MOTOSIKLET', 'TRAKTOR', 'OZEL_AMACLI_TASIT')) AS diger,\n  sumIf(vehicles, classification = 'BILINMEYEN') AS bilinmeyen,\n  sum(vehicles) AS total,\n  round(avgMerge(speed_avg), 1) AS avg_speed_kmh,\n  round(max(speed_max), 1) AS max_speed_kmh\nFROM iot.vehicles_1m\nWHERE $__timeFilter(minute) AND tunnel_id IN (${tunnel:singlequote})\nGROUP BY tunnel_id\nORDER BY total DESC\nLIMIT 50",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.21.3",
          "refId": "A"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 8,
