      "type": "table",
      "title": "Unhealthy devices (latest report in range)",
      "description": "Devices self-report their condition; empty means all of them are healthy.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT sensor_id, any(tunnel_id) AS tunnel, argMax(device_id, ts) AS device_id,\n  argMax(device_serial, ts) AS serial, any(position) AS position,\n  argMax(status, ts) AS status,\n  argMax(missed, ts) AS missed,\n  argMax(duplicates, ts) AS duplicates,\n  argMax(detections, ts) AS detections,\n  max(ts) AS last_report\nFROM iot.sensor_health\nWHERE $__timeFilter(ts) AND tunnel_id IN (${tunnel:singlequote})\nGROUP BY sensor_id\nHAVING status != 'ok'\nORDER BY missed DESC\nLIMIT 100",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.21.3",
          "refId": "A"
        }
