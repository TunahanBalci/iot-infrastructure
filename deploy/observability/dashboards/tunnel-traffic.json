          "rawSql": "SELECT $__timeInterval(ts) AS time,\n  sum(arraySum(mapValues(start_to_end))) AS start_to_end,\n  sum(arraySum(mapValues(end_to_start))) AS end_to_start\nFROM iot.traffic\nWHERE $__timeFilter(ts) AND tunnel_id IN (${tunnel:singlequote})\nGROUP BY time\nORDER BY time",
          "format": 0,
