          "rawSql": "SELECT $__timeInterval(ts_entry) AS time,\n  quantile(0.5)(speed_kmh) AS p50,\n  quantile(0.85)(speed_kmh) AS p85,\n  quantile(0.95)(speed_kmh) AS p95\nFROM iot.vehicles\nWHERE $__timeFilter(ts_entry) AND tunnel_id IN (${tunnel:singlequote})\nGROUP BY time\nORDER BY time",
