    {
      "type": "timeseries",
      "title": "Inbound PUBLISH in the client actor (avg)",
      "description": "The devices only publish, so this is the broker's hot path: how long a PUBLISH waits in the client actor's mailbox and how long handling it takes.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (pod) (rate(clientActor_processing_time_seconds_sum{job=\"tbmq\",msgType=\"MQTT_PUBLISH_MSG\"}[$__rate_interval])) / sum by (pod) (rate(clientActor_processing_time_seconds_count{job=\"tbmq\",msgType=\"MQTT_PUBLISH_MSG\"}[$__rate_interval]))",
          "legendFormat": "processing {{pod}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (pod) (rate(clientActor_msgInQueueTime_seconds_sum{job=\"tbmq\"}[$__rate_interval])) / sum by (pod) (rate(clientActor_msgInQueueTime_seconds_count{job=\"tbmq\"}[$__rate_interval]))",
          "legendFormat": "mailbox wait {{pod}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
