      "description": "Broker log lines only. Quiet here is the healthy state.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No warnings or errors from the brokers in this range - widen the time picker to see older ones."
