        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:=\"thingsboard-mqtt-broker\" AND kubernetes.container_name:=\"server\" AND (WARN OR ERROR)",
