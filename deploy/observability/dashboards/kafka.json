    {
      "type": "timeseries",
      "title": "Lag by consumer group",
      "description": "consensus is shown by its own unread-detections gauge: its committed offset trails by design, so its consumer-group lag measures the in-transit window, not a backlog.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (strimzi_io_cluster, consumergroup) (clamp_min(kafka_consumergroup_lag{job=\"kafka-exporter\",strimzi_io_cluster=~\"$kafka_cluster\",consumergroup!=\"consensus\"}, 0))",
          "legendFormat": "{{strimzi_io_cluster}} {{consumergroup}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(consensus_kafka_lag_records)",
          "legendFormat": "app-kafka consensus (unread detections)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
