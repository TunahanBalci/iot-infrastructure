    {
      "type": "stat",
      "title": "Tunnels with an alert",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT uniqExact(tunnel_id) AS tunnels\nFROM (\n  SELECT tunnel_id FROM iot.speeding_alerts WHERE $__timeFilter(ts_entry) AND tunnel_id IN (${tunnel:singlequote})\n  UNION ALL\n  SELECT tunnel_id FROM iot.restricted_alerts WHERE $__timeFilter(ts_entry) AND tunnel_id IN (${tunnel:singlequote})\n)",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.21.3",
          "refId": "A"
