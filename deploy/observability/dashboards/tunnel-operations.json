    {
      "type": "table",
      "title": "Speed limit exceeded",
      "description": "Which vehicle, how fast, in which tunnel, when (Europe/Istanbul) \u2014 and by how much it was over the posted limit. Counts vehicles seen by 2+ sensors and more than 5% over the limit: that margin filters out sensor speed noise on traffic cruising at the cap, leaving real speeders only. The 1000 newest alerts in the range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toString(local_time) AS time, tunnel_name AS tunnel, city, plate, vehicle_type AS type,\n  round(speed_kmh, 1) AS speed_kmh, speed_limit_kmh AS limit_kmh, over_by_kmh, over_by_pct\nFROM iot.speeding_alerts\nWHERE $__timeFilter(ts_entry) AND tunnel_id IN (${tunnel:singlequote})\nORDER BY local_time DESC\nLIMIT 1000",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.21.3",
          "refId": "A"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "No speeding in the selected time range. Expect only a couple per tunnel per day - widen the range if the dashboard looks empty."
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 6,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "table",
      "title": "Restricted vehicle detected",
      "description": "A vehicle type that is not allowed in that tunnel during that part of the day; times are Europe/Istanbul. The 1000 newest alerts in the range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toString(local_time) AS time, tunnel_name AS tunnel, city, plate, vehicle_type AS type,\n  banned_window, round(speed_kmh, 1) AS speed_kmh, direction, lane\nFROM iot.restricted_alerts\nWHERE $__timeFilter(ts_entry) AND tunnel_id IN (${tunnel:singlequote})\nORDER BY local_time DESC\nLIMIT 1000",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.21.3",
          "refId": "A"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "No restricted vehicle entered a tunnel outside its allowed hours in the selected time range."
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 7,
      "gridPos": {
        "h": 9,
