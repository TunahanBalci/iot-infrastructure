        "type": "query",
        "name": "tunnel",
        "label": "Tunnel",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "ClickHouse"
        },
        "query": {
          "refId": "tunnel",
          "queryType": "sql",
          "rawSql": "SELECT tunnel_id FROM iot.tunnel_profiles FINAL ORDER BY tunnel_id\nUNION DISTINCT\nSELECT DISTINCT tunnel_id FROM iot.traffic WHERE ts > now() - INTERVAL 1 DAY LIMIT 2000"
        },
        "definition": "SELECT tunnel_id FROM iot.tunnel_profiles FINAL ORDER BY tunnel_id\nUNION DISTINCT\nSELECT DISTINCT tunnel_id FROM iot.traffic WHERE ts > now() - INTERVAL 1 DAY LIMIT 2000",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
