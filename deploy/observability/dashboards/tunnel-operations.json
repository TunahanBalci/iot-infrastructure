    {
      "type": "timeseries",
      "title": "Alerts over time",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(ts_entry) AS time, 'speeding' AS kind, count() AS alerts\nFROM iot.speeding_alerts\nWHERE $__timeFilter(ts_entry) AND tunnel_id IN (${tunnel:singlequote})\nGROUP BY time\nUNION ALL\nSELECT $__timeInterval(ts_entry) AS time, 'restricted' AS kind, count() AS alerts\nFROM iot.restricted_alerts\nWHERE $__timeFilter(ts_entry) AND tunnel_id IN (${tunnel:singlequote})\nGROUP BY time\nORDER BY time",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.21.3",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
