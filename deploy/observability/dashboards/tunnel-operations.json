          "editorType": "sql",
          "rawSql": "SELECT tunnel_id, sensor_id, device_id, device_serial AS serial, position, status,\n  detections, missed, duplicates, round(uptime_s / 3600, 1) AS uptime_h,\n  toString(last_report_ts) AS last_report\nFROM iot.device_health_latest\nWHERE tunnel_id IN (${tunnel:singlequote})\nORDER BY tunnel_id, position\nLIMIT 500",
