    {
      "type": "table",
      "title": "Alerts per tunnel",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT tunnel, sum(speeding) AS speeding, sum(restricted) AS restricted FROM (\n  SELECT tunnel_name AS tunnel, count() AS speeding, 0 AS restricted\n  FROM iot.speeding_alerts WHERE $__timeFilter(ts_entry) AND tunnel_id IN (${tunnel:singlequote}) GROUP BY tunnel\n  UNION ALL\n  SELECT tunnel_name AS tunnel, 0 AS speeding, count() AS restricted\n  FROM iot.restricted_alerts WHERE $__timeFilter(ts_entry) AND tunnel_id IN (${tunnel:singlequote}) GROUP BY tunnel\n)\nGROUP BY tunnel\nORDER BY restricted DESC, speeding DESC",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.21.3",
          "refId": "A"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "No alerts in any tunnel in the selected time range."
