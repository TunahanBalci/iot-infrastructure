# =============================================================================
# IoT infrastructure — central configuration
# =============================================================================
# Sourced by every script in scripts/. Every value is a default only:
#   - override per run:        make install CILIUM_VERSION=1.20.2
#   - override persistently:   put KEY=value lines in config.local.env (gitignored)
# Precedence: command line / environment > config.local.env > this file.
# =============================================================================

# --- Kubernetes access -------------------------------------------------------
: "${KUBECONFIG:=$HOME/.kube/config}"
: "${WAIT_TIMEOUT:=600}"                 # seconds to wait for rollouts / readiness

# --- Pinned versions ---------------------------------------------------------
: "${K3S_VERSION:=}"                     # empty = keep installed k3s (or latest stable on first install)
: "${HELM_VERSION:=v3.22.0}"
: "${CILIUM_VERSION:=1.20.1}"            # Helm chart version
: "${CILIUM_CLI_VERSION:=v0.18.5}"
: "${HUBBLE_VERSION:=v1.19.4}"
: "${CERT_MANAGER_VERSION:=v1.21.2}"
: "${ENVOY_GATEWAY_VERSION:=v1.9.1}"
: "${STRIMZI_VERSION:=1.2.0}"            # Strimzi operator Helm chart (Kafka CRD API v1)
: "${CNPG_CHART_VERSION:=0.29.0}"        # CloudNativePG operator Helm chart (operator 1.30.0)
: "${RELOADER_CHART_VERSION:=2.2.17}"    # Stakater Reloader Helm chart (Reloader v1.4.22)
: "${KEDA_VERSION:=2.20.2}"              # KEDA Helm chart = app version
: "${TOOLS_BIN_DIR:=$HOME/.local/bin}"   # where missing CLIs get installed

# --- k3s -------------------------------------------------------------------
: "${K3S_CLUSTER_CIDR:=10.42.0.0/16}"
: "${K3S_SERVICE_CIDR:=10.43.0.0/16}"
# Stable node address on a dummy interface (systemd unit iot-node-ip, started before k3s). The API
# server advertises it (kubernetes Service endpoint) and kubelet certificates include it, so a
# Wi-Fi/DHCP address change no longer breaks in-cluster API clients. Host-local /32.
: "${K3S_NODE_IP:=172.30.254.1}"
: "${K3S_NODE_IP_IFACE:=iot0}"
# External name used to tell whether CoreDNS still reaches a working upstream resolver.
: "${DNS_PROBE_NAME:=grafana.com}"

# --- Cilium ------------------------------------------------------------------
# Cilium runs with host networking and kube-proxy is disabled, so it must reach
# the API server directly. 127.0.0.1:6443 works on k3s servers and survives
# DHCP/Wi-Fi address changes. On agent-only nodes use 127.0.0.1:6444.
: "${K8S_SERVICE_HOST:=127.0.0.1}"
: "${K8S_SERVICE_PORT:=6443}"
: "${CILIUM_ROUTING_MODE:=native}"       # native | tunnel
: "${CILIUM_LB_MODE:=snat}"              # snat | dsr | hybrid  (dsr needs native routing + multi-node bare metal)
: "${CILIUM_LB_ACCELERATION:=disabled}"  # disabled | native | best-effort (XDP; not on Wi-Fi NICs)
: "${CILIUM_DEVICES:=}"                  # empty = auto-detect; e.g. "wlp4s0" or "eth+"
: "${CILIUM_OPERATOR_REPLICAS:=1}"       # 1 on single-node clusters (2nd replica stays Pending)

# --- LoadBalancer IPs (Cilium LB-IPAM) ---------------------------------------
# Default range is private and not announced: reachable from this host only
# (Cilium socket-LB). To expose on the LAN, pick free LAN IPs outside the DHCP
# range and set L2_ANNOUNCE=true.
: "${LB_POOL_START:=172.30.255.10}"
: "${LB_POOL_STOP:=172.30.255.30}"
: "${EDGE_LB_IP:=172.30.255.10}"         # Envoy Gateway (TBMQ UI / REST over HTTP/HTTPS)
: "${MQTT_LB_IP:=172.30.255.11}"         # TBMQ MQTTS 8883 (client certificate required), Cilium L4
: "${L2_ANNOUNCE:=false}"
: "${L2_INTERFACES:=^eth[0-9]+ ^enp.* ^wlp.*}"   # space-separated regexes

# --- Edge / TLS --------------------------------------------------------------
: "${DOMAIN:=iot.local}"                 # certs cover *.DOMAIN plus the LB IPs

# --- TBMQ --------------------------------------------------------------------
: "${TBMQ_NAMESPACE:=thingsboard-mqtt-broker}"   # must match namespace in upstream manifests
: "${TBMQ_MANIFESTS_DIR:=vendor/tbmq/k8s/minikube}"   # upstream manifests (kept unmodified)
: "${TBMQ_REPLICAS:=2}"
: "${TBMQ_IE_REPLICAS:=1}"                         # initial; KEDA scales between the min/max below
# Lean JVMs: explicit heaps and memory limits (upstream sets neither).
: "${TBMQ_HEAP:=2g}"
# A JVM needs roughly heap + 1.4Gi here (metaspace, Netty direct buffers, code cache, thread stacks):
# with a 1g heap, 1536Mi already kept ContainerMemoryNearLimit firing.
: "${TBMQ_MEMORY_LIMIT:=4Gi}"
: "${TBMQ_IE_HEAP:=768m}"
: "${TBMQ_IE_MEMORY_LIMIT:=1536Mi}"
# Executors scale out, so their request is what decides whether KEDA's extra pods fit on the node:
# keep it at the working set, not at the limit, or TBMQ_IE_MAX_REPLICAS reserves the whole node.
: "${TBMQ_IE_MEMORY_REQUEST:=1Gi}"
# Integration executor → app Kafka (TBMQ Kafka integration), scaled by KEDA on its internal Kafka lag.
# Integration executors run one integration each (TBMQ gives every integration a single-partition
# topic for ordering), so the number of integrations is the hard ceiling on executor parallelism.
# Shards split the tunnels across integrations: TBMQ_IE_SHARDS x 3 sensor positions integrations.
: "${TBMQ_IE_SHARDS:=4}"                          # tunnel groups per sensor position (1 = the old layout)
: "${TBMQ_IE_MIN_REPLICAS:=1}"
: "${TBMQ_IE_MAX_REPLICAS:=6}"                   # <= TBMQ_IE_SHARDS * 3 integrations
: "${TBMQ_IE_LAG_THRESHOLD:=5000}"                # messages of lag per integration before scaling out
# TBMQ's publish consumers commit synchronously after each processed pack and poll with no batch floor,
# so at 4k msg/s the internal Kafka saw 1.66 RPCs and 0.8 offset records per message (packs of 2.1
# messages). A fetch floor makes each poll return a real batch: fewer fetches, fewer commits, less
# broker CPU. The cost is at most fetch.max.wait.ms of extra latency per hop.
: "${TBMQ_MSG_CONSUMER_CONFIG:=fetch.min.bytes:65536;fetch.max.wait.ms:50}"
# Same for the integration executors, whose upstream default is max.poll.records:50.
: "${TBMQ_IE_MSG_CONSUMER_CONFIG:=max.poll.records:500;fetch.min.bytes:65536;fetch.max.wait.ms:50}"
: "${TBMQ_ADMIN_USER:=sysadmin@thingsboard.org}"   # UI / REST login used to create MQTT credentials
# Empty = generated once into .state/tbmq-admin-password; make install-tbmq replaces TBMQ's install
# default (sysadmin) with it. Set it in config.local.env only if you manage the password yourself.
: "${TBMQ_ADMIN_PASSWORD:=}"

# --- TBMQ data services (make install-operators install-tbmq-deps) -------------
# Operator-managed: Strimzi Kafka (dedicated to TBMQ), CloudNativePG Postgres, Valkey StatefulSet.
# Replication factors follow the replica counts (max 3); TBMQ topics are patched to match.
: "${KAFKA_VERSION:=4.3.1}"                     # must be supported by STRIMZI_VERSION
: "${KAFKA_METADATA_VERSION:=4.3-IV0}"
: "${KAFKA_REPLICAS:=1}"                        # KRaft nodes, each controller + broker
: "${KAFKA_STORAGE:=200Gi}"
: "${KAFKA_HEAP:=1536m}"
: "${KAFKA_MEMORY_LIMIT:=3Gi}"
: "${KAFKA_CPU_REQUEST:=500m}"
: "${POSTGRES_INSTANCES:=1}"                    # 1 primary + (N-1) streaming replicas
: "${POSTGRES_IMAGE:=ghcr.io/cloudnative-pg/postgresql:17.11-202609140816-minimal-trixie}"
: "${POSTGRES_STORAGE:=40Gi}"
: "${VALKEY_IMAGE:=valkey/valkey:8.1.10}"
: "${VALKEY_STORAGE:=10Gi}"                     # AOF persistence
: "${VALKEY_MAXMEMORY:=768mb}"                  # below the 1Gi container limit; writes fail instead of OOM
: "${VALKEY_EXPORTER_IMAGE:=oliver006/redis_exporter:v1.91.1}"
# One-time switch from the old upstream Postgres/Kafka/Valkey workloads. DELETES their data.
: "${LEGACY_DEPS_DELETE:=false}"

# --- Device authentication (MQTTS 8883, mutual TLS) ---------------------------
# Device certificates are signed by the cert-manager CA iot-device-ca (CN "<DOMAIN> device CA").
# ACL rules per certificate CN: deploy/tbmq/device-credentials.json.tpl
: "${DEVICE_CERTS_DIR:=$ROOT_DIR/.state/device-certs}"   # <tunnel>.pem (cert + CA chain), <tunnel>.key
: "${DEVICE_CERT_DAYS:=365}"

# --- Simulator (make sim-up) -------------------------------------------------
# One MQTT connection and one client certificate (CN = tunnel id) per tunnel, over MQTTS 8883.
#   make sim-up                                the curated tunnels of apps/simulator/config/tunnels.yaml
#   make sim-up MODE=generator LOAD=50000      synthetic tunnels sized to that many msg/s (load test)
: "${SIM_IMAGE:=tunnel-sim:local}"       # rebuilt automatically when apps/simulator/ changes
: "${SIM_CONTAINER:=tunnel-sim}"
: "${SIM_MODE:=profiles}"                # profiles | generator (override per run with MODE=)
: "${SIM_PROFILES_FILE:=$APPS_DIR/simulator/config/tunnels.yaml}"   # source of the profile tunnel ids
# Generator mode only: how many synthetic tunnels (= MQTT connections and device certificates).
: "${SIM_TUNNELS:=1000}"
# Messages per second per device (3 devices per tunnel). Profiles mode adds the 17:00-20:00 burst
# from config/simulator.yaml. LOAD= overrides this with a total across all devices.
: "${SIM_MSGS_PER_DEVICE_S:=2}"
: "${SIM_WORKERS:=auto}"                 # simulator processes; auto = available CPUs (max 16)
: "${SIM_METRICS_PORT:=9109}"            # tunnel_sim_* metrics on K3S_NODE_IP, scraped as a static target

# --- Optional layers ----------------------------------------------------------------
: "${STORAGE_ENABLED:=true}"                     # ClickHouse + SeaweedFS (make install-storage)
: "${OBSERVABILITY_ENABLED:=true}"               # VictoriaMetrics/Logs/Traces, Grafana, OTel (make install-observability)
: "${PIPELINE_NAMESPACE:=iot-pipeline}"          # app Kafka, telemetry-processor, consensus
: "${STORAGE_NAMESPACE:=iot-storage}"            # ClickHouse, SeaweedFS
: "${MONITORING_NAMESPACE:=monitoring}"          # observability layer (NetworkPolicy peer of storage)

# --- Application Kafka (make install-app-kafka) -----------------------------------
# Strimzi Kafka app-kafka in iot-pipeline, separate from TBMQ's internal Kafka: TLS + SCRAM-SHA-512,
# one KafkaUser with ACLs per client. Replication factor follows the replicas (max 3).
: "${APP_KAFKA_REPLICAS:=1}"
: "${APP_KAFKA_STORAGE:=200Gi}"
: "${APP_KAFKA_HEAP:=1536m}"
: "${APP_KAFKA_MEMORY_LIMIT:=3Gi}"
: "${APP_KAFKA_CPU_REQUEST:=500m}"
# Partitions are the parallelism ceiling of every consumer group and cannot be lowered later without
# recreating the topic: size them for the target rate, not for today's pod count.
: "${APP_KAFKA_INGEST_PARTITIONS:=48}"            # iot.mqtt.ingest: max telemetry-processor pods
: "${APP_KAFKA_TUNNEL_PARTITIONS:=48}"            # tunnel-keyed topics: max consensus pods
# High rates fill a disk fast (300k msg/s of ~250 B is ~75 MB/s per hop). Time-based retention alone
# cannot bound that, so the hot topics also carry a per-partition byte cap.
: "${APP_KAFKA_INGEST_RETENTION_MS:=3600000}"     # raw envelopes: 1 h
: "${APP_KAFKA_INGEST_RETENTION_BYTES:=1073741824}"   # 1 GiB per partition
: "${APP_KAFKA_DETECTIONS_RETENTION_MS:=10800000}"    # re-keyed detections: 3 h
: "${APP_KAFKA_DETECTIONS_RETENTION_BYTES:=1073741824}"

# --- Stream processing (make install-processing) -----------------------------------
# telemetry-processor (stateless) and consensus (stateful, tunnel ownership = Kafka partitions) in
# iot-pipeline, each scaled by KEDA on its consumer-group lag between MIN and MAX replicas.
: "${PROCESSOR_IMAGE:=telemetry-processor}"       # tag = content hash of apps/telemetry-processor/
: "${PROCESSOR_MIN_REPLICAS:=2}"
: "${PROCESSOR_MAX_REPLICAS:=6}"                 # <= APP_KAFKA_INGEST_PARTITIONS; bounded by node CPU
: "${PROCESSOR_LAG_THRESHOLD:=20000}"             # envelopes of lag per pod before scaling out
: "${PROCESSOR_BATCH_SIZE:=2000}"                 # records per consume() call
: "${PROCESSOR_CPU_REQUEST:=400m}"
: "${PROCESSOR_MEMORY_REQUEST:=192Mi}"
: "${PROCESSOR_MEMORY_LIMIT:=512Mi}"
: "${CONSENSUS_IMAGE:=tunnel-consensus}"          # tag = content hash of apps/consensus/
: "${CONSENSUS_MIN_REPLICAS:=2}"
: "${CONSENSUS_MAX_REPLICAS:=6}"                 # <= APP_KAFKA_TUNNEL_PARTITIONS; each scale-out rebalances tunnels
: "${CONSENSUS_LAG_THRESHOLD:=200000}"            # unread detections per pod before scaling out (via VictoriaMetrics)
: "${CONSENSUS_TRAFFIC_INTERVAL_S:=60}"           # per-tunnel traffic window report interval
# (device health comes from the devices themselves: simulator -> tunnels/+/sensors/+/health)
: "${CONSENSUS_BATCH_SIZE:=2000}"                # records per consume() call
: "${CONSENSUS_CPU_REQUEST:=500m}"
# Memory holds the detections of every vehicle still in transit: tunnels x arrival rate x transit
# time x 2 pending detections (139k pending, ~334Mi at 4k msg/s). It grows linearly with the message
# rate, so a 20k msg/s run needs roughly five times that.
: "${CONSENSUS_MEMORY_REQUEST:=384Mi}"
: "${CONSENSUS_MEMORY_LIMIT:=1536Mi}"
: "${TRACES_SAMPLE_RATIO:=0.01}"                  # OpenTelemetry trace sampling of both services

# --- Storage: ClickHouse + SeaweedFS S3 cold tier (make install-storage) --------------
# ClickHouse consumes the app Kafka topics (Kafka engine, SCRAM as KafkaUser clickhouse), keeps raw
# data on the hot PVC, moves aged parts to SeaweedFS (S3) and deletes them later (TTL).
: "${CLICKHOUSE_KAFKA_BOOTSTRAP:=app-kafka-kafka-bootstrap.${PIPELINE_NAMESPACE}.svc:9093}"
: "${SEAWEEDFS_IMAGE:=chrislusf/seaweedfs:4.47}"
: "${SEAWEEDFS_STORAGE:=300Gi}"                  # cold tier PVC (local-path does not enforce sizes)
: "${SEAWEEDFS_MEMORY_REQUEST:=128Mi}"
# The cold tier holds ClickHouse parts now: 256Mi was OOMKilled repeatedly once data started moving.
: "${SEAWEEDFS_MEMORY_LIMIT:=512Mi}"            # Mi or Gi; GOMEMLIMIT = 80%
: "${CLICKHOUSE_IMAGE:=clickhouse/clickhouse-server:26.8.6.5}"
: "${CLICKHOUSE_STORAGE:=200Gi}"                 # hot PVC
: "${CLICKHOUSE_CPU_REQUEST:=1}"
: "${CLICKHOUSE_MEMORY_REQUEST:=1Gi}"
: "${CLICKHOUSE_MEMORY_LIMIT:=4Gi}"              # the server caps itself at 80%
: "${CLICKHOUSE_S3_CACHE_SIZE:=512Mi}"           # local read cache for cold parts
: "${CLICKHOUSE_KAFKA_DETECTIONS_CONSUMERS:=8}"  # ~4k detections/s each at ~20% of a core
: "${CLICKHOUSE_VEHICLES_DEDUP_WINDOW_S:=3600}"  # rollups skip re-emitted event_ids seen within this window
# Tiering / retention in CLICKHOUSE_TTL_UNIT (DAY; MINUTE or HOUR only for testing). At 1000 tunnels
# running 24/7: detections ~5-8 GiB/day, vehicles ~2-3 GiB/day, 1-minute rollups ~0.3 GiB/day.
: "${CLICKHOUSE_TTL_UNIT:=DAY}"
: "${CLICKHOUSE_DETECTIONS_COLD_AFTER:=1}"
: "${CLICKHOUSE_DETECTIONS_DELETE_AFTER:=3}"
: "${CLICKHOUSE_REJECTED_DELETE_AFTER:=7}"
: "${CLICKHOUSE_VEHICLES_COLD_AFTER:=3}"
: "${CLICKHOUSE_VEHICLES_DELETE_AFTER:=7}"
: "${CLICKHOUSE_HEALTH_COLD_AFTER:=7}"           # traffic + sensor_health
: "${CLICKHOUSE_HEALTH_DELETE_AFTER:=30}"
: "${CLICKHOUSE_ROLLUP_1M_COLD_AFTER:=7}"
: "${CLICKHOUSE_ROLLUP_1M_DELETE_AFTER:=30}"
: "${CLICKHOUSE_ROLLUP_1H_COLD_AFTER:=7}"
# Long-term statistics window of the dashboards: vehicle types and average speed per hour and per
# day, one month back per tunnel (iot.vehicle_types_hourly / _daily).
: "${CLICKHOUSE_ROLLUP_1H_DELETE_AFTER:=31}"

# --- Observability (make install-observability) -------------------------------------
# VictoriaMetrics (VMSingle, vmagent, vmalert, Alertmanager, Grafana, kube-state-metrics, node-exporter),
# VictoriaLogs + Vector, VictoriaTraces, OpenTelemetry Collector in MONITORING_NAMESPACE.
# The charts' sync job and Grafana plugins download from the internet at install/start.
: "${VM_K8S_STACK_CHART_VERSION:=0.92.1}"       # VictoriaMetrics v1.151.0, operator v0.74.1, Grafana 13.1.1
: "${VICTORIA_LOGS_CHART_VERSION:=0.13.9}"      # VictoriaLogs v1.52.0, Vector 0.57.0
: "${VICTORIA_TRACES_CHART_VERSION:=0.1.11}"    # VictoriaTraces v0.11.0
: "${OTEL_COLLECTOR_CHART_VERSION:=0.173.1}"    # collector 0.160.0 (k8s distribution)
: "${OBS_METRICS_RETENTION:=7d}"
: "${OBS_METRICS_STORAGE:=20Gi}"
: "${OBS_LOGS_RETENTION:=3d}"
: "${OBS_LOGS_STORAGE:=20Gi}"
: "${OBS_TRACES_RETENTION:=3d}"
: "${OBS_TRACES_STORAGE:=10Gi}"
: "${GRAFANA_ADMIN_PASSWORD:=}"                 # empty = generated once into .state/grafana-admin-password
: "${VICTORIAMETRICS_URL:=http://vmsingle-vm.monitoring.svc:8428}"   # Prometheus API for KEDA (consensus scaling)
